   sh('paket').appendRow([nm, pk.Mata_Pelajaran, pk['Durasi_(Menit)'], 'Nonaktif', tok, pk.Waktu_Mulai, pk.Waktu_Berakhir]);
   const qs = soalPaket(pk, true), base = Date.now();
