   .map(o => { if (k === 'soal' && String(o.ID_Soal).trim() === '') o.ID_Soal = 'R' + o._row; return o; });
}

function inWin(p) {
 const n = new Date(), f = s => s ? new Date(String(s).replace(' ', 'T')) : null, a = f(p.Waktu_Mulai), b = f(p.Waktu_Berakhir);
 return (!a || n >= a) && (!b || n <= b);
}

