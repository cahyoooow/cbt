// Pencarian siswa/paket memakai cache; status siswa SELALU dibaca langsung dari barisnya (1 pembacaan kecil)
function findSiswa(nama) {
 const key = nz(nama);
 const c = rowsC('siswa').find(x => nz(x.Nama_Siswa) === key);
 if (!c) { // tidak ada di cache: cek langsung (mis. guru baru menambah siswa manual di sheet)
   const f = rows('siswa').find(x => nz(x.Nama_Siswa) === key);
   if (f) cbump();
   return f || null;
 }
 const v = sh('siswa').getRange(c._row, 1, 1, 4).getValues()[0];
 if (nz(v[0]) !== key) { // baris bergeser: muat ulang
   cbump();
   return rows('siswa').find(x => nz(x.Nama_Siswa) === key) || null;
 }
 return {_row: c._row, Nama_Siswa: v[0], Kelas: v[1], Status_Ujian: v[2], Status_Akun: v[3]};
}
function findPaket(token) {
 const t = String(token).trim().toUpperCase(), f = x => String(x.Token_Paket_Soal).trim().toUpperCase() === t;
 const c = rowsC('paket').find(f);
 if (c) return c;
 const l = rows('paket').find(f);
 if (l) cbump();
 return l || null;
}
// Cek hasil sudah ada: hanya membaca kolom Nama & Paket (tanpa kolom JSON jawaban yang besar)
function hasilRow(nama, paket) {
 const s = sh('hasil'), last = s.getLastRow();
 if (last < 2) return 0;
 const a = s.getRange(2, 2, last - 1, 1).getValues(), b = s.getRange(2, 9, last - 1, 1).getValues();
 for (let i = 0; i < a.length; i++) if (a[i][0] === nama && b[i][0] === paket) return i + 2;
 return 0;
}

function verifyStudentLogin(nama, token) {
 const s = findSiswa(nama);
 if (!s) return {ok:false, msg:'Nama siswa tidak terdaftar.'};
 if (s.Status_Akun !== 'Aktif') return {ok:false, msg:'Akun Anda nonaktif. Hubungi guru.'};

 const p = findPaket(token);
 if (!p) return {ok:false, msg:'Token paket soal salah.'};
 if (p.Status !== 'Aktif') return {ok:false, msg:'Paket soal belum aktif.'};
 if (!inWin(p)) return {ok:false, msg:'Ujian di luar jadwal yang ditentukan.'};
 if (hasilRow(s.Nama_Siswa, p.Nama_Paket_Soal)) return {ok:false, msg:'Anda sudah menyelesaikan ujian ini.'};
 const resume = s.Status_Ujian === 'Sedang Ujian: ' + p.Nama_Paket_Soal;
 let progres = null;
 if (resume) progres = getProgress(s.Nama_Siswa, p.Nama_Paket_Soal, s._row);
 else clearProg(s.Nama_Siswa, p.Nama_Paket_Soal, s._row); // sisa lama dibuang
 sh('siswa').getRange(s._row, 3).setValue('Sedang Ujian: ' + p.Nama_Paket_Soal);
 return {ok:true, resume, progres, judul:cfgC().judul, nama:s.Nama_Siswa, kelas:s.Kelas, token:String(p.Token_Paket_Soal),
   paket:{nama:p.Nama_Paket_Soal, mapel:p.Mata_Pelajaran, durasi:Number(p['Durasi_(Menit)']) || 60},
   tib:rowsC('tib').map(x => x.Tata_Tertib)};
}

