// ===== Cache & performa (agar kuat untuk ±90 siswa serentak) =====
// Data yang jarang berubah (siswa, paket, soal, pengaturan) disimpan di CacheService.
// Setiap perubahan lewat menu admin menaikkan "versi" cache (cbump) sehingga data lama otomatis tidak dipakai.
const CC = () => CacheService.getScriptCache();
function ver() { const c = CC(); let v = c.get('ver'); if (!v) { v = String(Date.now()); c.put('ver', v, 21600); } return v; }
function cbump() { CC().put('ver', String(Date.now()) + Math.floor(Math.random() * 1000), 21600); }
// Nilai besar dipecah per 32.000 karakter (batas CacheService 100KB per entri)
function cput(key, obj, ttl) {
  try {
    const s = JSON.stringify(obj), n = Math.ceil(s.length / 32000) || 1, m = {};
    for (let i = 0; i < n; i++) m[key + '#' + i] = s.slice(i * 32000, (i + 1) * 32000);
    m[key + '#n'] = String(n);
    CC().putAll(m, ttl);
  } catch (e) {}
}
function cget(key) {
  try {
    const c = CC(), n = Number(c.get(key + '#n'));
    if (!n) return null;
    const ks = []; for (let i = 0; i < n; i++) ks.push(key + '#' + i);
    const m = c.getAll(ks); let s = '';
    for (let i = 0; i < n; i++) { if (m[ks[i]] == null) return null; s += m[ks[i]]; }
    return JSON.parse(s);
  } catch (e) { return null; }
}
function memo(key, ttl, fn) { const k = key + '@' + ver(); let v = cget(k); if (v === null) { v = fn(); cput(k, v, ttl); } return v; }
const rowsC = k => memo('rows:' + k, 60, () => rows(k));
const cfgC = () => memo('cfg', 120, cfg);

