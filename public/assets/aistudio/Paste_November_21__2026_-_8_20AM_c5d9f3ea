// Frontend (index.html di GitHub) memanggil fungsi di bawah lewat fetch POST {fn, args}.
// Hanya fungsi pada daftar ini yang boleh dipanggil dari luar.
const API = {verifyAdminLogin, verifyStudentLogin, getQuestionsForStudent, saveProgress, logViolation, submitStudentExam, admin, uploadImage, getImg, getSettings};

function doGet(e) {
 // ?api=1 -> cek status API; selain itu tampilkan aplikasi (Index.html) seperti semula
 if (e && e.parameter && e.parameter.api) return ContentService.createTextOutput(JSON.stringify({ok:true, msg:'CBT API aktif'})).setMimeType(ContentService.MimeType.JSON);
 return HtmlService.createHtmlOutputFromFile('Index').setTitle(cfgC().judul)
   .addMetaTag('viewport', 'width=device-width, initial-scale=1')
   .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function doPost(e) {
 let out;
 try {
   const req = JSON.parse(e.postData.contents), f = Object.prototype.hasOwnProperty.call(API, req.fn) ? API[req.fn] : null;
   if (!f) throw new Error('Fungsi tidak diizinkan: ' + req.fn);
   const d = f.apply(null, req.args || []);
   out = {ok:true, data: d === undefined ? null : d};
 } catch (err) {
   out = {ok:false, error: String(err && err.message || err)};
 }
 return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

