 qs.sort((a, b) => (Number(a.Nomor_Soal) || 0) - (Number(b.Nomor_Soal) || 0));
 // Dikirim sebagai teks JSON agar aman dari masalah serialisasi
 return JSON.stringify(qs.map(q => {
   const o = {};
   H.soal.forEach(c => { if (c === 'Kunci_Jawaban' || c === 'Pembahasan') return; const v = q[c]; o[c] = v == null ? '' : (typeof v === 'number' ? v : String(v)); });
   return o;
 }));
}

const R2 = x => Math.round(x * 100) / 100;
const OPT = ['A','B','C','D'];
const hasOpt = (q, k) => { const v = q['Pilihan_' + k]; return v != null && String(v) !== ''; };

// Skor satu soal -> {skor, maks}
//  PG           : benar = bobot penuh, salah = 0
//  PGK MCMA     : tiap pilihan (A-D) yang sesuai dengan kunci bernilai bobot/jumlah pilihan
//                 contoh kunci A,B jawab A,C, bobot 2 -> A & D sesuai = 2/4 x 2 = 1
//  PGK Kategori : tiap pernyataan yang jawabannya sesuai kunci bernilai bobot/jumlah pernyataan
function scoreQ(q, a) {
 const t = String(q.Jenis_Soal).split(':')[0], w = Number(q.Bobot) || 1;
 const op = OPT.filter(k => hasOpt(q, k)), n = op.length || 1;
 const arr = Array.isArray(a) ? a.map(String) : String(a == null ? '' : a).split(',');
 let skor = 0;
 if (t === 'PGK MCMA') {
   const kk = nz(q.Kunci_Jawaban).split(',').filter(Boolean), aa = arr.map(nz).filter(Boolean);
   if (aa.length) skor = w * op.filter(k => kk.includes(k.toLowerCase()) === aa.includes(k.toLowerCase())).length / n;
 } else if (t === 'PGK Kategori') {
   const kk = String(q.Kunci_Jawaban).split(',').map(nz);
   skor = w * OPT.filter((k, i) => hasOpt(q, k) && nz(arr[i]) !== '' && nz(arr[i]) === kk[i]).length / n;
 } else {
   const x = nz(arr.join(','));
   skor = x !== '' && x === nz(q.Kunci_Jawaban) ? w : 0;
 }
 return {skor: R2(skor), maks: w};
}

function soalPaket(pk, live) {
 return (live ? rows('soal') : rowsC('soal')).filter(x => pn(x.Paket) === pn(pk.Nama_Paket_Soal)).sort((a, b) => (Number(a.Nomor_Soal) || 0) - (Number(b.Nomor_Soal) || 0));
}

function calcScore(pk, ans, qs) {
 qs = qs || soalPaket(pk);
 let tot = 0, got = 0;
 const rev = qs.map(q => {
   const a = ans[q.ID_Soal] == null ? '' : ans[q.ID_Soal], s = scoreQ(q, a);
   tot += s.maks; got += s.skor;
   return {no:q.Nomor_Soal, soal:q.Teks_Soal, jawab:Array.isArray(a) ? a.join(',') : a, kunci:q.Kunci_Jawaban,
     skor:s.skor, maks:s.maks, benar:s.skor === s.maks, pembahasan:q.Pembahasan};
 });
 got = R2(got); tot = R2(tot);
 return {nilai: tot ? R2(got / tot * 100) : 0, benar: got, salah: R2(tot - got), rev};
}

function submitStudentExam(nama, token, ans, viol) {
 const sw = findSiswa(nama), pk = findPaket(token);
 if (!sw || !pk) throw new Error('Data tidak valid');
 return scoreSave(sw, pk, ans, viol);
}

// Rekap hanya ditulis SEKALI per siswa+paket. Penilaian dihitung DI LUAR kunci; bagian terkunci hanya
// cek-ganda + tulis 1 baris (singkat), supaya 90 siswa yang kirim bersamaan tidak saling menunggu lama.
// Total_Benar = skor benar (poin), Total_Salah = skor salah (poin)
function scoreSave(sw, pk, ans, viol) {
 const r = calcScore(pk, ans), dk = 'dn:' + nz(sw.Nama_Siswa) + '|' + pn(pk.Nama_Paket_Soal);
 let dup = CC().get(dk) ? hasilRow(sw.Nama_Siswa, pk.Nama_Paket_Soal) : 0; // kirim ganda: tak perlu antre kunci
 if (!dup) {
   const lock = LockService.getScriptLock();
   lock.waitLock(100000);
   try {
     dup = hasilRow(sw.Nama_Siswa, pk.Nama_Paket_Soal);
     if (!dup) sh('hasil').appendRow([new Date(), sw.Nama_Siswa, sw.Kelas, r.nilai, r.benar, r.salah, viol || 0, JSON.stringify(ans), pk.Nama_Paket_Soal]);
   } finally { lock.releaseLock(); }
 }
 if (dup) { // sudah terkirim: kembalikan hasil yang tersimpan
   let a0 = {}; try { a0 = JSON.parse(sh('hasil').getRange(dup, 8).getValue() || '{}'); } catch (e) {}
   return calcScore(pk, a0);
 }
 CC().put(dk, '1', 21600);
 sh('siswa').getRange(sw._row, 3).setValue('Selesai');
 clearProg(sw.Nama_Siswa, pk.Nama_Paket_Soal, sw._row);
 return r;
}

// ===== Progres ujian (jawaban + sisa waktu) =====
// Dipanggil browser siswa tiap ada perubahan jawaban dan berkala (mis. 10 detik) dengan sisa waktu terakhir.
// Saat siswa reload / jendela tertutup, timer berhenti; saat login lagi, jawaban & sisa waktu dilanjutkan.
// Baris progres tiap siswa diusahakan sama dengan nomor barisnya di sheet siswa -> tanpa kunci & tanpa pencarian.
// Bila baris itu sudah dipakai data lain, jatuh ke jalur lama (kunci + cari/tambah baris).
const progKey = (nama, paket) => 'pr:' + nz(nama) + '|' + pn(paket);
function findProg(nama, paket, hint) {
 const s = sh('prog'), last = s.getLastRow();
 if (last < 2) return 0;
 const c = CC(), k = progKey(nama, paket);
 const chk = r => { if (!(r >= 2 && r <= last)) return false; const v = s.getRange(r, 1, 1, 2).getValues()[0]; return nz(v[0]) === nz(nama) && pn(v[1]) === pn(paket); };
 const h = Number(c.get(k)) || 0;
 if (h && chk(h)) return h;
 if (hint && chk(hint)) { c.put(k, String(hint), 21600); return hint; }
 const v = s.getRange(2, 1, last - 1, 2).getValues();
 for (let i = 0; i < v.length; i++) if (nz(v[i][0]) === nz(nama) && pn(v[i][1]) === pn(paket)) { c.put(k, String(i + 2), 21600); return i + 2; }
 return 0;
}
function clearProg(nama, paket, hint) {
 const r = findProg(nama, paket, hint);
 if (r) { sh('prog').getRange(r, 1, 1, H.prog.length).clearContent(); CC().remove(progKey(nama, paket)); }
}

function saveProgress(nama, token, ans, sisa, viol) {
 const sw = findSiswa(nama), pk = findPaket(token);
 if (!sw || !pk) throw new Error('Data tidak valid');
 if (sw.Status_Ujian !== 'Sedang Ujian: ' + pk.Nama_Paket_Soal) return false; // sudah selesai / direset admin
 const v = [sw.Nama_Siswa, pk.Nama_Paket_Soal, JSON.stringify(ans || {}), Math.max(0, Math.floor(Number(sisa) || 0)), new Date(), Number(viol) || 0];
 const s = sh('prog');
 let r = findProg(sw.Nama_Siswa, pk.Nama_Paket_Soal, sw._row);
 if (!r) { const cand = sw._row; if (cand >= 2 && cand <= s.getMaxRows() && String(s.getRange(cand, 1).getValue()).trim() === '') r = cand; }
 if (r) { s.getRange(r, 1, 1, v.length).setValues([v]); CC().put(progKey(sw.Nama_Siswa, pk.Nama_Paket_Soal), String(r), 21600); return true; }
 const lock = LockService.getScriptLock(); // jalur cadangan
 lock.waitLock(20000);
 try {
   const r2 = findProg(sw.Nama_Siswa, pk.Nama_Paket_Soal);
   if (r2) s.getRange(r2, 1, 1, v.length).setValues([v]); else s.appendRow(v);
 } finally { lock.releaseLock(); }
 return true;
}

function getProgress(nama, paket, hint) {
 const r = findProg(nama, paket, hint);
 if (!r) return null;
 const v = sh('prog').getRange(r, 1, 1, H.prog.length).getValues()[0];
 let jawaban = {}; try { jawaban = JSON.parse(v[2] || '{}'); } catch (e) {}
 const sisa = Number(v[3]);
 return {jawaban, sisa: isNaN(sisa) || v[3] === '' ? null : sisa, viol: Number(v[5]) || 0, t: v[4] instanceof Date ? v[4].getTime() : 0};
}

const cleanAns = a => { const o = Object.assign({}, a || {}); delete o.__ragu; delete o.__i; return o; };

// Progres semua siswa untuk satu paket: {kunciNama: {ans, sisa, t(ms), viol}}
function progMap(paket) {
 const s = sh('prog'), last = s.getLastRow(), m = {};
 if (last < 2) return m;
 s.getRange(2, 1, last - 1, H.prog.length).getValues().forEach(v => {
   if (String(v[0]).trim() === '' || pn(v[1]) !== pn(paket)) return;
   let ans = {}; try { ans = JSON.parse(v[2] || '{}'); } catch (e) {}
   const sisa = Number(v[3]);
   m[nz(v[0])] = {ans, sisa: isNaN(sisa) || v[3] === '' ? null : sisa, t: v[4] instanceof Date ? v[4].getTime() : 0, viol: Number(v[5]) || 0};
 });
 return m;
}

// Dikosongkan (bukan deleteRow) agar nomor baris progres siswa lain tidak bergeser saat ada yang bersamaan
function delProg(f) {
 const s = sh('prog');
 rows('prog').filter(f).forEach(x => { s.getRange(x._row, 1, 1, H.prog.length).clearContent(); CC().remove(progKey(x.Nama_Siswa, x.Paket)); });
}

function logViolation(nama, jenis) {
 const s = findSiswa(nama);
 if (!s) return;
 const lock = LockService.getScriptLock();
 let got = false;
 try { lock.waitLock(15000); got = true; } catch (e) {}
