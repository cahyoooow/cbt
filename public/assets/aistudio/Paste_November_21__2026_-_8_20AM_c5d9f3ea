 if (a === 'copyPaket') { // salin paket beserta seluruh soalnya
   const pk = rows('paket').find(x => x.Nama_Paket_Soal === p.v);
   if (!pk) throw new Error('Paket tidak ditemukan');
   const all = rows('paket'), names = new Set(all.map(x => pn(x.Nama_Paket_Soal))), toks = new Set(all.map(x => String(x.Token_Paket_Soal).toUpperCase()));
