function uploadImage(pw, name, mime, b64) {
 if (!verifyAdminLogin(pw)) throw new Error('Akses ditolak');
 if (!/^image\/(png|jpe?g|gif|webp)$/.test(mime)) throw new Error('Format gambar tidak didukung');
 const f = imgFolder().createFile(Utilities.newBlob(Utilities.base64Decode(b64), mime, name));
 // Jika akun sekolah melarang berbagi publik, abaikan: gambar tetap tampil lewat getImg()
 try { f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) {}
 return 'https:\/\/drive.google.com/thumbnail?sz=w1200&id=' + f.getId();
}

// Mengirim gambar sebagai data-URI (tidak butuh file dibagikan publik). Hanya file di folder CBT_Gambar.
function getImg(id) {
 if (!/^[\w-]{10,}$/.test(String(id))) throw new Error('ID gambar tidak valid');
 const ck = 'img:' + id, hit = cget(ck); // hanya id yang lolos pemeriksaan folder yang pernah masuk cache
 if (hit) return hit;
 const f = DriveApp.getFileById(id), fid = imgFolder().getId(), ps = f.getParents();
 let ok = false;
 while (ps.hasNext()) if (ps.next().getId() === fid) ok = true;
 if (!ok) throw new Error('Gambar tidak diizinkan');
 const b = f.getBlob(), d = 'data:' + b.getContentType() + ';base64,' + Utilities.base64Encode(b.getBytes());
 cput(ck, d, 21600);
 return d;
}

